{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "build",
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "lib": ["ES2022"]
  },
  "include": ["server", "shared"],
  "exclude": ["node_modules", "build", "dist"]
}
